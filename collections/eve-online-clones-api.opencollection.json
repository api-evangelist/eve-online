{
  "opencollection": "1.0.0",
  "info": {
    "name": "EVE Swagger Interface Alliance Clones API",
    "version": "1.36"
  },
  "items": [
    {
      "info": {
        "name": "Clones",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "EVE Online Get Clones",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://esi.evetech.net/latest/characters/:character_id/clones/",
            "headers": [
              {
                "name": "If-None-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "character_id",
                "value": "",
                "type": "path",
                "description": "An EVE character ID"
              },
              {
                "name": "datasource",
                "value": "",
                "type": "query",
                "description": "The server name you would like data from"
              },
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Access token to use if unable to set a header"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://login.eveonline.com/v2/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "A list of the character's clones\n\n---\nAlternate route: `/dev/characters/{character_id}/clones/`\n\nAlternate route: `/legacy/characters/{character_id}/clones/`\n\nAlternate route: `/v2/characters/{character_id}/clones/`\n\nAlternate route: `/v3/characters/{character_id}/clones/`\n\nAlternate route: `/v4/characters/{character_id}/clones/`\n\n---\nThis route is cached for up to 120 seconds"
        },
