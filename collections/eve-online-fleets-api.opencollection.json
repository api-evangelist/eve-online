            "headers": [
              {
                "name": "If-None-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "character_id",
                "value": "",
                "type": "path",
                "description": "An EVE character ID"
              },
              {
                "name": "datasource",
                "value": "",
                "type": "query",
                "description": "The server name you would like data from"
              },
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Access token to use if unable to set a header"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://login.eveonline.com/v2/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Return the fleet ID the character is in, if any.\n\n---\nAlternate route: `/dev/characters/{character_id}/fleet/`\n\nAlternate route: `/legacy/characters/{character_id}/fleet/`\n\nAlternate route: `/v1/characters/{character_id}/fleet/`\n\nAlternate route: `/v2/characters/{character_id}/fleet/`\n\n---\nThis route is cached for up to 60 seconds"
